# Supabase — te vinden in je project onder Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key: ALLEEN op de server. Nooit in een NEXT_PUBLIC_ variabele
# zetten en nooit committen. Nodig om leden uit te nodigen per e-mail.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# De basis-URL van de site. Laat leeg lokaal; op Vercel je echte domein.
NEXT_PUBLIC_SITE_URL=https://www.jouwdomein.be
